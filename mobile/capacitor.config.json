{
  "appId": "id.kustore.app",
  "appName": "Kustore",
  "webDir": "www",
  "server": {
    "url": "https://kustore.id/dashboard",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
      "kustore.id",
      "id.kuartal.id"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#F1FBFF",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#F1FBFF"
    }
  }
}

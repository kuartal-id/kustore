# Kustore root .htaccess (Apache / LiteSpeed)
#
# Only matters when the host serves the REPOSITORY ROOT as the web root
# (Hostinger Git deploy into public_html). Preferred setup is still to point
# the domain's document root at public/; then this file is never used.
#
# Every request is routed into public/. Framework directories and files are
# refused with 403 as defence in depth.

Options -Indexes -MultiViews

<IfModule mod_headers.c>
    Header always unset X-Powered-By
</IfModule>

# Sensitive files anywhere in the tree
<FilesMatch "(^\.env|^\.git|composer\.(json|lock)$|package(-lock)?\.json$|^artisan$|phpunit\.xml$|\.md$|\.log$|\.sqlite$|\.sh$|^\.editorconfig$|^\.gitattributes$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Framework/source directories, dotfiles (except .well-known) -> 403
    RewriteRule ^(\.git|\.github|app|bootstrap|config|database|resources|routes|tests|vendor|node_modules|bin|docs)(/|$) - [F,L,NC]
    # Real storage internals -> 403 (public uploads live under /storage/avatars, /storage/products via public/storage)
    RewriteRule ^storage/(logs|framework|app)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|phpunit\.xml|.+\.md|\.env.*)$ - [F,L,NC]

    # Everything else is served from public/ (public/.htaccess then hands off to index.php)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
